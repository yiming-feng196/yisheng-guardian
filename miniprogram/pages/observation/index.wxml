<view
  class="page observation {{largeText ? 'large' : ''}}"
  style="--nav-space:{{navSpace}}px"
>
  <view class="scene-background">
    <image
      class="scene-background-art"
      src="/assets/scene-atmosphere.png"
      mode="scaleToFill"
      aria-hidden="true"
    />
  </view>
  <image class="ginkgo" src="/assets/ginkgo-glass.png" mode="aspectFit" aria-hidden="true" />
  <page-header title="认知观察" subtitle="看看图片，说说您看到的故事。" wave="{{true}}">
    <status-pill slot="aside" label="{{mode === 'live' ? '语音观察' : '流程体验'}}" tone="{{mode === 'live' ? 'neutral' : 'demo'}}" />
  </page-header>
  <step-progress steps="{{steps}}" current="{{step}}" />
  <view class="observation-card glass-surface">
    <block wx:if="{{step === 0}}">
      <view class="observation-heading">
        <view class="feature-symbol">
          <image src="/assets/icons/observation-active.png" mode="aspectFit" />
        </view>
        <text class="title">从一张图片开始</text>
      </view>
      <text class="body-text intro-copy">看看图片，说说您看到的故事。不着急，也没有标准答案。</text>
      <image
        class="intro-illustration"
        src="/assets/illustrations/observation-glass.png"
        mode="aspectFit"
        aria-label="磨砂玻璃相框主题插图"
      />
      <text class="secondary experience-note">{{mode === 'live' ? '录音后可先试听或删除。确认上传后，录音会发送到当前账号的后端，供语音转写和观察分析。' : '当前为流程体验，不会录音或生成健康评估。'}}</text>
      <checkbox-group bindchange="onConsentChange">
        <label class="consent-row">
          <checkbox value="consent" checked="{{consent}}" color="#168773" />
          <text>{{mode === 'live' ? '我同意为本次观察处理录音、转写和图片任务记录。观察结果仅供参考。' : '我已了解，继续体验流程示例。'}}</text>
        </label>
      </checkbox-group>
      <button wx:if="{{mode === 'live' && !signedIn}}" class="btn btn-secondary" bindtap="openProfile">前往登录</button>
      <button wx:else
        class="btn btn-primary"
        disabled="{{!consent}}"
        hover-class="pressed"
        bindtap="nextStep"
      >
        {{mode === 'live' ? '同意并继续' : '开始体验'}}
        <image src="/assets/icons/arrow-right-white.png" mode="aspectFit" />
      </button>
    </block>
    <block wx:elif="{{step === 1}}">
      <text class="title">看图讲述</text>
      <text class="body-text section-gap">请仔细看看这张图片，说说画面中发生了什么。</text>
      <image
        class="task-picture"
        src="/assets/observation.jpg"
        mode="widthFix"
        aria-label="看图讲述任务图片"
      />
      <block wx:if="{{mode === 'demo'}}">
      <view wx:if="{{sampleReady}}" class="sample-selected">
        <status-pill label="已选择流程示例" tone="success" />
      </view>
      <text class="secondary experience-note">此处不会启动麦克风，也不会上传录音。</text>
      <button
        class="btn {{sampleReady ? 'btn-secondary' : 'btn-primary'}}"
        hover-class="pressed"
        bindtap="prepareSample"
      >
        {{sampleReady ? '已选择流程示例' : '选择流程示例'}}
      </button>
      <view class="step-actions">
        <button class="btn btn-secondary" bindtap="previousStep">上一步</button>
        <button class="btn btn-primary" disabled="{{!sampleReady}}" bindtap="nextStep">
          下一步
        </button>
      </view>
      </block>
      <block wx:else>
        <view class="audio-placeholder" aria-role="status">{{clock}} · {{status}}</view>
        <text wx:if="{{error}}" class="secondary experience-note" aria-role="status">{{error}}</text>
        <view class="step-actions" wx:if="{{phase === 'idle'}}">
          <button class="btn btn-secondary" bindtap="previousStep">上一步</button>
          <button class="btn btn-primary" bindtap="startRecording">开始录音</button>
        </view>
        <button wx:if="{{needsSettings}}" class="btn btn-secondary" bindtap="openMicSettings">打开录音权限设置</button>
        <view class="step-actions" wx:if="{{phase !== 'idle'}}">
          <button wx:if="{{phase === 'recording'}}" class="btn btn-secondary" bindtap="pauseRecording">暂停</button>
          <button wx:if="{{phase === 'paused'}}" class="btn btn-secondary" bindtap="resumeRecording">继续</button>
          <button wx:if="{{phase === 'paused' || phase === 'recording'}}" class="btn btn-primary" bindtap="stopRecording">结束</button>
          <button class="btn btn-plain" bindtap="cancelRecording">取消</button>
        </view>
      </block>
    </block>
    <block wx:elif="{{step === 2 && mode === 'demo'}}">
      <text class="title">确认体验内容</text>
      <view class="confirmation-symbol">
        <image src="/assets/icons/document.png" mode="aspectFit" />
      </view>
      <text class="body-text">本次仅为流程体验，未采集真实录音。</text>
      <text class="secondary experience-note">
        真实录音开放后，可在这里试听、重新录制和确认提交。
      </text>
      <view class="audio-placeholder">
        <text>暂无音频文件</text>
        <text class="secondary">播放与提交将在录音功能开放后启用</text>
      </view>
      <view class="step-actions">
        <button class="btn btn-secondary" bindtap="previousStep">返回看图</button>
        <button class="btn btn-primary" bindtap="nextStep">完成体验</button>
      </view>
    </block>
    <block wx:elif="{{step === 2}}">
      <text class="title">确认录音</text>
      <view class="audio-placeholder" aria-role="status">{{clock}} · {{status}}</view>
      <text wx:if="{{error}}" class="secondary experience-note" aria-role="status">{{error}}</text>
      <progress wx:if="{{phase === 'uploading'}}" percent="{{progress}}" show-info activeColor="#168773" />
      <block wx:elif="{{phase !== 'reconciling'}}">
        <view class="step-actions">
          <button class="btn btn-secondary" bindtap="togglePlayback">{{playing ? '停止试听' : '试听录音'}}</button>
          <button class="btn btn-secondary" bindtap="removeRecording">删除并重录</button>
        </view>
        <button wx:if="{{phase === 'uncertain'}}" class="btn btn-secondary section-gap" bindtap="openRecords">查看录音记录</button>
        <button wx:if="{{!signedIn}}" class="btn btn-secondary section-gap" bindtap="openProfile">重新登录</button>
        <button wx:elif="{{phase === 'uncertain'}}" class="btn btn-primary section-gap" bindtap="confirmRetry">核对后重试</button>
        <button wx:else class="btn btn-primary section-gap" bindtap="submitRecording">{{phase === 'failed' ? '重试上传' : '上传录音'}}</button>
      </block>
    </block>
    <block wx:elif="{{mode === 'live'}}">
      <text class="title">录音已上传</text>
      <text class="secondary experience-note">可在记录页试听录音或发起观察分析。</text>
      <button class="btn btn-primary" bindtap="openRecords">查看记录</button>
      <button class="btn btn-plain section-gap" bindtap="restart">录制另一段</button>
    </block>
    <block wx:else>
      <view class="completion-symbol">
        <image src="/assets/icons/check-circle.png" mode="aspectFit" />
      </view>
      <text class="title result-title">本次流程体验已完成</text>
      <text class="body-text result-copy">当前未进行真实录音与认知分析。</text>
      <text class="secondary experience-note">不会生成健康评分、风险等级或观察报告。</text>
      <button class="btn btn-primary" bindtap="openCompanion">回到陪伴页</button>
      <button class="btn btn-plain section-gap" bindtap="restart">重新体验</button>
    </block>
  </view>
  <text class="page-note">观察信息仅供参考，不能替代专业诊断。</text>
</view>
