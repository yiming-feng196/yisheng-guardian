.progress-card { padding:26rpx 28rpx; margin-bottom:24rpx; border-radius:28rpx; background:#fff; }
.progress-label { font-size:.84em; font-weight:600; }
.steps { display:flex; margin-top:24rpx; }
.step { flex:1; min-width:0; color:#63636b; font-size:.68em; text-align:center; }
.step+.step { margin-left:12rpx; }
.step-track { height:8rpx; margin-bottom:14rpx; border-radius:8rpx; background:#e9e9ee; }
.current { color:#176b52; font-weight:600; }
.current .step-track,.complete .step-track { background:#176b52; }
.introduction { padding:36rpx 32rpx 28rpx; }
.observation-symbol { display:flex; align-items:center; justify-content:center; width:96rpx; height:96rpx; margin-bottom:28rpx; border-radius:28rpx; background:#e9f3ee; }
.observation-symbol image { width:58rpx; height:58rpx; }
.intro-title { font-size:1.42em; line-height:1.35; font-weight:650; letter-spacing:-.03em; }
.intro-copy { color:#63636b; margin-top:16rpx; font-size:.88em; line-height:1.7; }
.intro-points { margin:30rpx 0; }
.intro-point { display:flex; align-items:center; padding:16rpx 0; }
.point-number { flex-shrink:0; display:flex; align-items:center; justify-content:center; width:56rpx; height:56rpx; margin-right:20rpx; border-radius:50%; color:#176b52; background:#edf5f0; font-size:.8em; font-weight:600; }
.point-title { font-size:.94em; font-weight:500; }
.info-note { padding:22rpx; border-radius:20rpx; background:#f5f5f9; color:#63636b; font-size:.76em; line-height:1.7; }
.consent { display:flex; align-items:center; min-height:100rpx; padding:12rpx 4rpx; font-size:.86em; }
.consent checkbox { flex-shrink:0; margin-right:14rpx; }
.task-image { width:100%; border-radius:24rpx; display:block; }
.recording-placeholder { display:flex; align-items:center; justify-content:center; width:144rpx; height:144rpx; margin:8rpx auto 32rpx; border-radius:50%; background:#e9f3ee; }
.recording-placeholder image { width:64rpx; height:64rpx; }
.large .step { font-size:.62em; }
