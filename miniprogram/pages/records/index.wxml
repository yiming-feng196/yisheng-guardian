<view class="page records-page {{largeText ? 'large' : ''}}">
  <view class="page-header"><view class="page-title">观察记录</view></view>
  <environment-notice mode="{{mode}}" />
  <view class="section-heading"><text class="section-heading-title">{{mode === 'demo' ? '示例记录' : '全部记录'}}</text><text class="section-caption">下拉可刷新</text></view>
  <view wx:if="{{loading}}" class="group loading-records" role="status"><view class="loading-row"><view class="skeleton-icon"></view><view class="skeleton-copy"><view class="skeleton-line"></view><view class="skeleton-line short"></view></view></view><view class="loading-caption">正在读取记录…</view></view>
  <view wx:elif="{{error}}" class="card empty"><image class="empty-icon" src="/assets/icons/connection.png" mode="aspectFit" /><view class="empty-title">暂时无法读取记录</view><view class="status error" selectable>{{error}}</view><view class="button-row"><button size="mini" class="secondary-button" hover-class="pressable" hover-start-time="0" bindtap="loadRecords">重试</button><button size="mini" class="primary-button" hover-class="pressable" hover-start-time="0" bindtap="openProfile">账号与连接</button></view></view>
  <view wx:elif="{{!records.length}}" class="card empty"><image class="empty-icon" src="/assets/icons/records-active.png" mode="aspectFit" /><view class="empty-title">故事，等待开始</view><view class="note">还没有观察记录。<br />完成一次真实观察后，可在这里查看任务。</view><button size="mini" class="secondary-button spaced" hover-class="pressable" hover-start-time="0" bindtap="openObservation">了解认知观察</button></view>
  <view wx:else class="group record-list">
    <button size="mini" wx:for="{{records}}" wx:key="id" class="record" hover-class="pressable" hover-start-time="0" bindtap="showRecord" data-index="{{index}}" aria-label="{{item.title}}，{{item.status}}，查看详情">
      <view class="row-icon"><image src="/assets/icons/document.png" mode="aspectFit" /></view>
      <view class="record-copy"><view class="record-title">{{item.title}}</view><view class="record-description">{{item.description}}</view><text class="badge neutral">{{item.status}}</text></view>
      <image class="chevron" src="/assets/icons/chevron.png" mode="aspectFit" />
    </button>
  </view>
  <view class="page-end">{{mode === 'demo' ? '示例记录仅帮助您了解使用方式。' : '观察信息仅供参考，不能替代专业诊断。'}}</view>
</view>
