<view
  class="page records {{largeText ? 'large' : ''}}"
  style="--nav-space:{{navSpace}}px"
>
  <view class="scene-background">
    <image
      class="scene-background-art"
      src="/assets/scene-atmosphere.png"
      mode="scaleToFill"
      aria-hidden="true"
    />
  </view>
  <image class="ginkgo" src="/assets/ginkgo-glass.png" mode="aspectFit" aria-hidden="true" />
  <page-header title="观察记录" subtitle="记录每一次观察，关注点滴变化。" />
  <view wx:if="{{needsLogin}}">
    <empty-state
      title="登录后查看您的观察记录"
      message="使用已有项目账号登录，查看属于您的观察任务。"
      icon="profile-active"
      action="前往登录"
      bindaction="openProfile"
    />
  </view>
  <view
    wx:elif="{{loading}}"
    class="skeleton-list"
    aria-role="status"
    aria-label="正在读取观察记录"
  >
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="record-skeleton glass-surface">
      <view class="skeleton-symbol"></view>
      <view class="skeleton-copy">
        <view></view>
        <view></view>
        <view></view>
      </view>
    </view>
    <text class="page-note">正在读取记录…</text>
  </view>
  <view wx:elif="{{error && !records.length}}">
    <empty-state
      title="暂时无法读取记录"
      message="{{error}}"
      icon="connection"
      error="{{true}}"
      action="重试"
      bindaction="loadRecords"
    />
  </view>
  <view wx:elif="{{!records.length}}">
    <empty-state
      title="暂无观察记录"
      message="完成一次观察后，记录将在这里显示。当前流程体验不会生成真实记录。"
      action="前往观察"
      bindaction="openObservation"
    />
  </view>
  <block wx:else>
    <view class="records-toolbar">
      <status-pill
        label="{{mode === 'demo' ? '演示记录 · 非真实观察结果' : '当前账号的观察记录'}}"
        tone="{{mode === 'demo' ? 'demo' : 'neutral'}}"
      />
      <button
        class="refresh-button"
        size="mini"
        bindtap="loadRecords"
        hover-class="pressed"
        aria-label="刷新记录"
      >
        刷新
      </button>
    </view>
    <text wx:if="{{error}}" class="inline-feedback text-error" aria-role="status">{{error}}</text>
    <view class="record-list">
      <button
        wx:for="{{records}}"
        wx:key="id"
        class="record-card glass-surface"
        size="mini"
        data-index="{{index}}"
        bindtap="showRecord"
        hover-class="pressed"
        aria-label="{{item.title}}，{{item.statusLabel}}，{{item.actionLabel}}"
      >
        <view class="record-symbol">
          <image src="/assets/icons/records-active.png" mode="aspectFit" />
        </view>
        <view class="record-copy">
          <text class="record-title">{{item.title}}</text>
          <text wx:if="{{item.displayTime}}" class="record-time">{{item.displayTime}}</text>
          <view class="record-status">
            <status-pill label="{{item.statusLabel}}" tone="{{item.statusTone}}" />
          </view>
        </view>
        <view class="record-arrow">
          <text>{{item.actionLabel}}</text>
          <image src="/assets/icons/chevron.png" mode="aspectFit" />
        </view>
      </button>
    </view>
    <text class="page-note">
      {{mode === 'demo' ? '示例仅展示页面流程，不代表真实健康信息。' :
      '观察信息仅供参考，不能替代专业诊断。'}}
    </text>
  </block>
  <glass-modal
    visible="{{reportVisible}}"
    title="{{selectedRecord.title}}"
    caption="{{selectedRecord.displayTime}}"
    content="{{selectedRecord.content}}"
    footnote="{{mode === 'demo' ? '演示内容，不是健康评估或医学结论。' : '观察信息仅供参考，不能替代专业诊断。'}}"
    confirm-text="关闭"
    bindclose="closeReport"
    bindconfirm="closeReport"
  />
</view>
