<view
  class="page companion {{largeText ? 'large' : ''}} {{chatOpen ? 'chat-is-open' : ''}} {{keyboardHeight > 0 ? 'keyboard-open' : ''}}"
  style="height:calc(100% - {{keyboardInset}}px);--nav-space:{{keyboardHeight > 0 ? 8 : navSpace}}px"
>
  <view class="scene-background">
    <image
      class="scene-background-art"
      src="/assets/scene-atmosphere.png"
      mode="scaleToFill"
      aria-hidden="true"
    />
  </view>
  <image class="ginkgo" src="/assets/ginkgo-glass.png" mode="aspectFit" aria-hidden="true" />
  <view class="identity">
    <view class="identity-top">
      <view class="identity-name">
        <text>小忆</text>
        <view class="name-wave" aria-hidden="true">
          <view></view>
          <view></view>
          <view></view>
        </view>
      </view>
      <button
        class="connection-button"
        size="mini"
        aria-label="{{connectionLabel}}，打开服务设置"
        bindtap="openProfile"
      >
        <status-pill label="{{connectionLabel}}" tone="{{connection}}" />
      </button>
    </view>
    <text class="identity-subtitle">你的认知健康陪伴助手</text>
  </view>
  <view class="human-stage">
    <digital-human
      state="{{sending ? 'thinking' : inputFocused ? 'input' : replyPresented ? 'responding' : connection === 'unavailable' ? 'error' : 'idle'}}"
      active="{{pageActive}}"
      compact="{{chatOpen}}"
    />
  </view>
  <view wx:if="{{!chatOpen}}" class="home-actions">
    <view class="greeting glass-surface glass-float">
      <view class="greeting-accent"></view>
      <view>
        <text class="greeting-title">今天想聊些什么？</text>
        <text class="greeting-subtitle">我在这里，陪你聊天、讲故事。</text>
      </view>
    </view>
    <view class="quick-topics">
      <button
        class="topic glass-surface"
        data-message="想和你聊聊今天的生活。"
        disabled="{{sending}}"
        bindtap="onQuickTopic"
        hover-class="pressed"
      >
        <image src="/assets/icons/companion-active.png" mode="aspectFit" />
        <text>聊聊今天</text>
      </button>
      <button
        class="topic glass-surface"
        data-message="请给我讲一个温暖的小故事。"
        disabled="{{sending}}"
        bindtap="onQuickTopic"
        hover-class="pressed"
      >
        <image src="/assets/icons/book.png" mode="aspectFit" />
        <text>听个故事</text>
      </button>
      <button class="topic glass-surface" bindtap="openObservation" hover-class="pressed">
        <image src="/assets/icons/leaf.png" mode="aspectFit" />
        <text>认知小练习</text>
      </button>
    </view>
  </view>
  <view class="chat-host">
    <chat-panel
      id="chat-panel"
      expanded="{{chatOpen}}"
      messages="{{messages}}"
      value="{{input}}"
      sending="{{sending}}"
      scroll-target="{{scrollTarget}}"
      mode="{{mode}}"
      bindinput="onInput"
      bindfocus="onInputFocus"
      bindblur="onInputBlur"
      bindkeyboard="onKeyboardHeight"
      bindsend="sendMessage"
      bindexpand="openChat"
      bindcollapse="closeChat"
    />
  </view>
  <text wx:if="{{mode === 'demo' && !chatOpen}}" class="home-mode">
    演示模式 · 静态形象与示例回复
  </text>
</view>
