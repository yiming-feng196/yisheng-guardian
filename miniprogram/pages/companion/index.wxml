<view class="page companion-page {{largeText ? 'large' : ''}}">
  <view class="companion-header">
    <view><view class="eyebrow">忆声陪伴 · 此刻，小忆陪着您</view><view class="companion-title">小忆<text>您的数字陪伴者</text></view></view>
    <button class="settings-button glass" hover-class="pressable" hover-start-time="0" bindtap="openProfile" aria-label="打开我的与设置"><image src="/assets/icons/settings.png" mode="aspectFit" /></button>
  </view>
  <environment-notice mode="{{mode}}" />
  <view class="avatar-stage {{chatOpen ? 'with-chat' : ''}}">
    <view class="ambient-orb orb-one"></view><view class="ambient-orb orb-two"></view>
    <button class="avatar-touch" hover-class="avatar-pressed" hover-start-time="0" bindtap="openChat" aria-label="与数字人小忆开始文字聊天" aria-expanded="{{chatOpen}}">
      <image class="avatar-portrait" src="/assets/avatar-companion.png" mode="aspectFit" />
    </button>
    <view class="avatar-state glass" role="status"><view class="state-dot"></view>{{sending ? '正在思考您的话…' : (mode === 'live' ? '可以开始文字聊天' : '数字人形象 · 演示模式')}}</view>
    <view wx:if="{{!chatOpen}}" class="hero-caption glass">
      <view class="hero-title">今天，也陪着您。</view>
      <view class="hero-subtitle">聊聊生活，分享心情。<br />您慢慢说，我一直在这里。</view>
      <button class="start-chat" hover-class="pressable" hover-start-time="0" bindtap="openChat">和小忆聊聊<image src="/assets/icons/arrow-right.png" mode="aspectFit" /></button>
    </view>
    <view class="chat-sheet glass {{chatOpen ? 'sheet-open' : ''}}" aria-hidden="{{!chatOpen}}">
      <button class="sheet-heading" hover-class="pressable" hover-start-time="0" bindtap="closeChat" aria-label="收起对话，返回数字人"><view class="sheet-grabber"></view><view class="sheet-heading-row"><text>和小忆聊聊</text><view class="sheet-close"><image src="/assets/icons/chevron-down.png" mode="aspectFit" /></view></view></button>
      <scroll-view class="messages" scroll-y scroll-into-view="{{scrollTarget}}" aria-label="聊天内容">
        <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="message-wrap {{item.role}}">
          <view wx:if="{{item.role === 'assistant'}}" class="message-author">小忆<text wx:if="{{mode === 'demo'}}"> · 演示回复</text></view>
          <view class="message {{item.error ? 'failed' : ''}}"><text selectable>{{item.content}}</text></view>
        </view>
        <view wx:if="{{sending}}" class="thinking" role="status">小忆正在想一想…</view>
        <view class="message-spacer"></view>
      </scroll-view>
    </view>
  </view>
  <view class="companion-dock">
    <view wx:if="{{!chatOpen}}" class="quick-topics">
      <button class="topic glass" hover-class="pressable" hover-start-time="0" bindtap="onQuickTopic" data-message="今天有点累，想找人聊聊。" disabled="{{sending}}"><image src="/assets/icons/sun.png" mode="aspectFit" /><text>聊聊今天</text></button>
      <button class="topic glass" hover-class="pressable" hover-start-time="0" bindtap="onQuickTopic" data-message="给我讲一个温暖的小故事吧。" disabled="{{sending}}"><image src="/assets/icons/book.png" mode="aspectFit" /><text>听个故事</text></button>
    </view>
    <view class="composer glass">
      <button class="voice-button" hover-class="pressable" hover-start-time="0" bindtap="showVoicePlan" aria-label="语音交流，尚未开放"><image src="/assets/icons/microphone.png" mode="aspectFit" /></button>
      <textarea class="chat-input" value="{{input}}" maxlength="500" placeholder="和小忆说说话…" placeholder-class="placeholder" bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur" focus="{{inputFocused}}" disabled="{{sending}}" auto-height cursor-spacing="24" show-confirm-bar="{{false}}" confirm-type="send" bindconfirm="sendMessage" aria-label="输入聊天消息" />
      <button class="send-button" hover-class="pressable" hover-start-time="0" bindtap="sendMessage" loading="{{sending}}" disabled="{{sending || !input}}" aria-label="发送消息"><image wx:if="{{!sending}}" src="/assets/icons/arrow-up.png" mode="aspectFit" /></button>
    </view>
    <view class="composer-note">{{mode === 'live' ? '文字单轮问答 · 语音与数字人视频尚未接入' : '演示形象与回复 · 语音交流尚未开放'}}</view>
  </view>
</view>
