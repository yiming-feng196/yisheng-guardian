.companion {
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding-top: 16rpx;
  padding-bottom: calc(var(--nav-space, 100px) + 10rpx);
  overflow: hidden;
}
.companion .ginkgo {
  top: 28%;
  right: 16rpx;
  width: 150rpx;
  height: 180rpx;
}
.identity {
  flex: none;
  position: relative;
  z-index: 1;
}
.identity-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.identity-name {
  display: flex;
  align-items: center;
  gap: 22rpx;
  font-size: var(--font-name);
  font-weight: 650;
  letter-spacing: -1rpx;
  line-height: 1.2;
}
.name-wave {
  display: flex;
  align-items: center;
  gap: 7rpx;
  height: 42rpx;
}
.name-wave view {
  width: 8rpx;
  height: 20rpx;
  border-radius: 9rpx;
  background: linear-gradient(#58bcb1, #a2dcd5);
}
.name-wave view:nth-child(2) {
  height: 38rpx;
}
.connection-button {
  padding: 0 !important;
  background: transparent !important;
  margin: 0 !important;
  line-height: 1;
  max-width: 49%;
  height: auto !important;
  min-height: 44px;
  display: flex !important;
  align-items: center;
}
.identity-subtitle {
  display: block;
  font-size: var(--font-secondary);
  line-height: 1.5;
  color: #586779;
  margin-top: 8rpx;
}
.human-stage {
  position: relative;
  flex: 1;
  min-height: 180rpx;
  margin: 0 -26rpx -6rpx;
}
.home-actions {
  position: relative;
  z-index: 2;
  flex: none;
}
.greeting {
  display: flex;
  gap: 22rpx;
  align-items: center;
  padding: 28rpx 30rpx;
  border-radius: 42rpx;
}
.greeting-accent {
  align-self: stretch;
  width: 6rpx;
  min-height: 72rpx;
  border-radius: 9rpx;
  background: linear-gradient(rgba(131, 197, 181, 0.3), #168773, rgba(131, 197, 181, 0.12));
  flex: none;
}
.greeting-title {
  display: block;
  font-size: var(--font-greeting);
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -0.5rpx;
}
.greeting-subtitle {
  display: block;
  font-size: var(--font-secondary);
  color: #586779;
  line-height: 1.5;
  margin-top: 10rpx;
}
.quick-topics {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 22rpx 0;
}
.topic {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 20rpx 8rpx;
  min-height: 92rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #142536;
}
.topic image {
  width: 36rpx;
  height: 36rpx;
  flex: none;
}
.topic text {
  white-space: nowrap;
}
.chat-host {
  flex: none;
  height: 208rpx;
  min-height: 0;
  position: relative;
  z-index: 3;
}
.home-mode {
  flex: none;
  text-align: center;
  color: #805e38;
  font-size: var(--font-status);
  line-height: 1.4;
  margin-top: 12rpx;
}
.chat-is-open .human-stage {
  flex: 0 1 210rpx;
  min-height: 120rpx;
  max-height: 24%;
  margin-bottom: 8rpx;
}
.chat-is-open .chat-host {
  flex: 1;
  height: 0;
  min-height: 220rpx;
}
.keyboard-open .human-stage {
  flex: 0 1 110rpx;
  min-height: 64rpx;
}
.keyboard-open .identity-subtitle {
  display: none;
}
.large .topic {
  font-size: 32rpx;
  flex-basis: 180rpx;
}
.large .greeting {
  padding: 24rpx;
}
.large .human-stage {
  min-height: 120rpx;
}
.large .chat-host {
  height: 224rpx;
}
.large.chat-is-open .chat-host {
  height: 0;
}
.large .identity-top {
  flex-wrap: wrap;
}
.large .connection-button {
  max-width: 100%;
}
@media (max-width: 350px) {
  .companion {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .topic {
    font-size: 27rpx;
    padding: 18rpx 6rpx;
    gap: 6rpx;
  }
  .topic image {
    width: 30rpx;
    height: 30rpx;
  }
  .identity-name {
    font-size: 56rpx;
  }
  .greeting {
    padding: 24rpx;
  }
  .human-stage {
    min-height: 150rpx;
  }
}
@media (max-height: 640px) {
  .quick-topics {
    margin: 14rpx 0;
  }
  .greeting {
    padding-top: 20rpx;
    padding-bottom: 20rpx;
  }
  .companion:not(.chat-is-open) .human-stage {
    min-height: 120rpx;
  }
  .home-mode {
    margin-top: 6rpx;
  }
}

.topic {
  font-size: max(14px, 26rpx);
}
.large .topic {
  font-size: max(17px, 32rpx);
}
.large.companion:not(.chat-is-open) {
  overflow-y: auto;
}
.large.companion:not(.chat-is-open) .human-stage {
  flex-shrink: 0;
  min-height: 180rpx;
}
.companion::-webkit-scrollbar {
  display: none;
}
@media (max-width: 350px) {
  .companion {
    padding-left: 16px;
    padding-right: 16px;
  }
  .quick-topics .topic {
    flex-basis: 40%;
    min-width: 40%;
    font-size: 14px;
  }
  .large .quick-topics .topic {
    font-size: 17px;
  }
  .companion:not(.chat-is-open) {
    overflow-y: auto;
  }
  .companion:not(.chat-is-open) .human-stage {
    flex-shrink: 0;
    min-height: 240rpx;
  }
}

.human-stage{transition:flex-grow 280ms ease,flex-basis 280ms ease,max-height 280ms ease}
.chat-host{transition:flex-grow 300ms ease,height 300ms ease}
@media(prefers-reduced-motion:reduce){.human-stage,.chat-host{transition:none}}
