.companion-page {
  display:flex; flex-direction:column; height:100%; min-height:0;
  padding:8rpx 0 24rpx; overflow:hidden;
  background:linear-gradient(160deg,#f1f5f2 0%,#e5eee9 65%,#f4eeeb 100%);
}
.home-header { display:flex; align-items:center; justify-content:space-between; flex:none; min-height:88rpx; padding:0 32rpx; }
.companion-name { color:#233c30; font-size:1.36em; font-weight:600; letter-spacing:-.02em; }
.connection-label { display:flex; align-items:center; flex:none; width:auto; min-height:44px; max-width:60%; margin:0; padding:0 4rpx 0 16rpx; color:#52665a; background:transparent; font-size:.82em; line-height:1.5; font-weight:400; }
.connection-dot { flex:none; width:10rpx; height:10rpx; margin-right:12rpx; border-radius:50%; background:#176b52; }
.connection-label.offline { color:#9b463b; }
.offline .connection-dot { background:#b65749; }
.avatar-stage { position:relative; flex:1; min-height:0; overflow:hidden; }
.ambient-light { position:absolute; top:10%; left:0; right:0; bottom:12%; border-radius:50%; background:radial-gradient(ellipse,rgba(165,195,171,.42),rgba(229,238,233,0) 70%); pointer-events:none; }
.avatar-touch { position:absolute; top:0; left:0; right:0; bottom:168rpx; -webkit-mask-image:linear-gradient(180deg,#000 0%,#000 86%,transparent 100%); mask-image:linear-gradient(180deg,#000 0%,#000 86%,transparent 100%); transition:opacity 180ms ease-out; }
.avatar-portrait { display:block; width:100%; height:100%; }
.greeting { position:absolute; bottom:18rpx; left:32rpx; right:32rpx; text-align:center; pointer-events:none; }
.greeting-title { font-size:1.42em; font-weight:600; line-height:1.3; letter-spacing:-.025em; color:#233c30; }
.greeting-detail { margin-top:8rpx; color:#596b5e; font-size:.9em; line-height:1.5; }
.companion-dock { flex:none; padding:12rpx 28rpx 0; }
.quick-topics { display:flex; justify-content:center; margin:0 0 16rpx; }
.topic { flex:1; width:44%; min-width:0; max-width:44%; min-height:44px; margin:0; padding:16rpx 20rpx; border-radius:50rpx; background:rgba(255,255,255,.58); color:#355642; font-size:1em; font-weight:400; line-height:1.45; }
.topic+.topic { margin-left:16rpx; }
.composer { display:flex; align-items:center; width:100%; min-height:56px; padding:6px 8px 6px 16px; border-radius:28px; }
.input-container { flex:1; width:calc(100% - 56px); min-width:0; padding-right:12px; }
.chat-input { display:block; width:100%; height:44px; min-height:44px; margin:0; padding:0; border:0; background:transparent; color:#1c1c1e; font-size:1em; line-height:44px; }
.chat-placeholder { color:#6b776f; }
.send-button { display:flex; align-items:center; justify-content:center; flex:none; width:44px; height:44px; min-width:44px; max-width:44px; min-height:44px; margin:0; padding:0; border-radius:50%; background:#176b52; color:#fff; line-height:44px; }
.send-button image { display:block; width:22px; height:22px; }
.with-chat .avatar-touch { opacity:.16; }
.chat-sheet { position:absolute; display:flex; flex-direction:column; top:8rpx; right:24rpx; bottom:0; left:24rpx; border-radius:32rpx; background:rgba(250,252,250,.9); opacity:0; transform:translateY(20rpx); visibility:hidden; pointer-events:none; transition:opacity 180ms ease-out,transform 220ms cubic-bezier(.32,.72,0,1),visibility 0s linear 220ms; }
.chat-sheet.sheet-open { opacity:1; transform:translateY(0); visibility:visible; pointer-events:auto; transition:opacity 180ms ease-out,transform 220ms cubic-bezier(.32,.72,0,1); }
.sheet-heading { display:flex; align-items:center; justify-content:space-between; flex:none; min-height:48px; padding:10px 16px; color:#233c30; font-size:1em; font-weight:500; }
.sheet-heading image { width:22px; height:22px; }
.messages { flex:1; min-height:0; height:0; width:100%; }
.message-wrap { margin:0 24rpx 20rpx; }
.message-author { margin:0 0 8rpx 4rpx; color:#5b6c60; font-size:.8em; }
.message { display:inline-block; max-width:94%; padding:18rpx 22rpx; border-radius:8rpx 24rpx 24rpx; background:#fff; white-space:pre-wrap; word-break:break-word; line-height:1.5; }
.user { text-align:right; }
.user .message { background:#176b52; color:#fff; border-radius:28rpx 8rpx 28rpx 28rpx; text-align:left; }
.message.failed { background:#fff0ed; color:#a33a31; }
.message-note { margin:10rpx 6rpx 0; color:#63636b; font-size:.82em; line-height:1.55; }
.thinking { padding:0 30rpx 24rpx; color:#5b6c60; font-size:.84em; }
.message-spacer { height:12rpx; }
.large .avatar-touch { bottom:192rpx; }
.large .greeting-title { font-size:1.28em; }
@media (max-height:580px) { .home-header { min-height:44px; } .greeting-detail { display:none; } .avatar-touch { bottom:82rpx; } .greeting-title { font-size:1.18em; } .quick-topics { margin-bottom:12rpx; } }
@media (prefers-reduced-motion:reduce) { .avatar-touch,.chat-sheet,.chat-sheet.sheet-open { transition:none; transform:none; } }
@media (prefers-reduced-transparency:reduce) { .composer,.chat-sheet { background:#f8faf8; -webkit-backdrop-filter:none; backdrop-filter:none; } }
@media (prefers-contrast:more) { .composer,.chat-sheet { background:#fff; border-color:#8e8e93; } }
