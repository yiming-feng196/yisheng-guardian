.profile .ginkgo {
  width: 160rpx;
  height: 200rpx;
  top: 70rpx;
  right: 24rpx;
  opacity: 0.45;
}
.account {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin: 0 6rpx 40rpx;
}
.account-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.85);
  background: linear-gradient(140deg, rgba(255, 255, 255, 0.65), rgba(218, 239, 233, 0.65));
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.account-avatar image {
  width: 62rpx;
  height: 62rpx;
}
.account-copy {
  flex: 1;
  min-width: 0;
}
.account-name {
  display: block;
  font-size: var(--font-card);
  font-weight: 600;
  line-height: 1.4;
  word-break: break-word;
}
.account-detail {
  display: block;
  color: #586779;
  font-size: var(--font-secondary);
  line-height: 1.5;
  margin-top: 10rpx;
}
.settings-group {
  padding: 0 28rpx;
  border-radius: 48rpx;
  overflow: hidden;
}
.setting-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.65);
}
.connection-details {
  padding: 0 0 30rpx;
  animation: details-enter 220ms ease-out;
}
.connection-details .form-label {
  margin-top: 0;
}
.service-explanation {
  display: block;
  margin: 18rpx 0 24rpx;
}
.mode-segment {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  margin: 0 0 26rpx 94rpx;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  background: rgba(225, 232, 244, 0.64);
}
.segment-option {
  flex: 1;
  margin: 0;
  padding: 16rpx 8rpx;
  min-height: 44px;
  background: transparent;
  color: #586779;
  font-size: var(--font-secondary);
  line-height: 1.4;
  border-radius: 19rpx;
}
.segment-option--selected {
  background: linear-gradient(135deg, #168773, #146653);
  color: #fff;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
}
.profile-feedback {
  display: block;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  font-size: var(--font-secondary);
  line-height: 1.65;
  word-break: break-word;
}
.login-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 44rpx;
}
.login-explanation {
  display: block;
  margin-top: 8rpx;
}
.password-field {
  position: relative;
}
.password-field .field {
  padding-right: 110rpx;
}
.password-toggle {
  position: absolute;
  right: 6rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 0 !important;
  width: 48px !important;
  height: 48px !important;
  line-height: 48px !important;
  font-size: var(--font-secondary) !important;
  color: #146653;
  background: transparent !important;
  margin: 0 !important;
}
.logout {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 30rpx 0 0;
  width: 100%;
  padding: 30rpx 36rpx;
  min-height: 104rpx;
  border-radius: 42rpx;
  background-color: rgba(255, 255, 255, 0.4);
  color: #b24f4f;
  font-size: var(--font-button);
  font-weight: 600;
  line-height: 1.5;
  text-align: left;
}
.logout image {
  width: 42rpx;
  height: 42rpx;
}
.large .mode-segment {
  margin-left: 0;
}
.large .password-field .field {
  padding-right: 130rpx;
}
.large .account {
  align-items: flex-start;
}
@keyframes details-enter {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@media (prefers-reduced-motion: reduce) {
  .connection-details {
    animation: none;
  }
}

.account-login {
  flex: none;
  margin: 0 !important;
  min-width: 44px;
  min-height: 44px;
  display: flex !important;
  align-items: center;
  justify-content: center;
  padding: 12rpx 20rpx !important;
  font-size: var(--font-secondary) !important;
  color: #146653;
  background: rgba(255, 255, 255, 0.6) !important;
  border-radius: 999px;
  line-height: 1.4;
}
.login-card {
  margin: 0 0 28rpx;
}
