<view class="page profile-page {{largeText ? 'large' : ''}}">
  <view class="page-header"><view class="page-title">我的</view></view>
  <view class="profile-card"><image class="profile-avatar" src="/assets/logo.png" mode="aspectFit" /><view class="row-copy"><view class="profile-name">{{loggedInUser || '忆声陪伴'}}</view><view class="row-detail">{{loggedInUser ? '欢迎回来' : '登录后查看您的观察记录'}}</view></view></view>
  <view class="group">
    <view class="group-row"><view class="row-copy"><view class="row-title">大字模式</view></view><switch checked="{{largeText}}" bindchange="onTextChange" color="#176b52" disabled="{{busy}}" aria-label="大字模式" /></view>
    <view class="group-row settings-row" role="button" tabindex="0" bindtap="toggleConnection" aria-expanded="{{connectionExpanded}}"><view class="row-copy"><view class="row-title">服务连接</view><view class="row-detail">{{mode === 'live' ? '已配置服务器' : '演示模式'}}</view></view><image class="chevron {{connectionExpanded ? 'expanded' : ''}}" src="/assets/icons/chevron.png" mode="aspectFit" /></view>
    <view wx:if="{{connectionExpanded}}" class="connection-fields">
      <view class="row spaced"><text>真实服务</text><switch checked="{{mode === 'live'}}" bindchange="onModeChange" color="#176b52" disabled="{{busy}}" aria-label="连接真实服务" /></view>
      <label class="field-label" for="backend-address">服务器地址</label><input id="backend-address" class="field" value="{{apiBaseUrl}}" bindinput="onBaseUrl" placeholder="http://电脑IP:8080" placeholder-class="placeholder" disabled="{{busy}}" aria-label="服务器地址" />
      <view class="button-row"><button size="mini" class="secondary-button" style="width:48%;min-width:0;max-width:48%;" hover-class="pressable" hover-start-time="0" bindtap="saveConfig" disabled="{{busy}}">保存</button><button size="mini" class="primary-button" style="width:48%;min-width:0;max-width:48%;" hover-class="pressable" hover-start-time="0" bindtap="testConnection" loading="{{busy}}" disabled="{{busy}}">测试连接</button></view>
      <view class="note spaced">手机请使用电脑的局域网地址。</view>
    </view>
  </view>
  <view class="section-heading"><text class="section-heading-title">账号</text></view>
  <view class="card account-card">
    <view wx:if="{{mode === 'demo'}}" class="note">连接真实服务后即可登录。</view>
    <block wx:elif="{{loggedInUser}}"><view class="row-title">{{loggedInUser}}</view><button size="mini" class="secondary-button spaced" hover-class="pressable" hover-start-time="0" bindtap="signOut" disabled="{{busy}}">退出登录</button></block>
    <block wx:else><label class="field-label account-first-label" for="username">账号</label><input id="username" class="field" value="{{username}}" bindinput="onUsername" placeholder="请输入账号" placeholder-class="placeholder" disabled="{{busy}}" maxlength="100" /><label class="field-label" for="password">密码</label><input id="password" class="field" value="{{password}}" bindinput="onPassword" placeholder="请输入密码" placeholder-class="placeholder" password disabled="{{busy}}" maxlength="128" /><button size="mini" class="primary-button spaced" hover-class="pressable" hover-start-time="0" bindtap="signIn" loading="{{busy}}" disabled="{{busy}}">登录</button></block>
  </view>
  <view wx:if="{{status}}" class="status {{statusError ? 'error' : ''}}" role="status"><text selectable>{{status}}</text></view>
  <view class="about-row" role="button" tabindex="0" bindtap="showAbout"><text>关于忆声</text><text>V0.1.0</text></view>
</view>
