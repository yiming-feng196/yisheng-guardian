<view
  class="page profile {{largeText ? 'large' : ''}}"
  style="--nav-space:{{navSpace}}px"
>
  <view class="scene-background">
    <image
      class="scene-background-art"
      src="/assets/scene-atmosphere.png"
      mode="scaleToFill"
      aria-hidden="true"
    />
  </view>
  <image class="ginkgo" src="/assets/ginkgo-glass.png" mode="aspectFit" aria-hidden="true" />
  <page-header title="我的" />
  <view class="account">
    <view class="account-avatar">
      <image src="/assets/icons/profile-active.png" mode="aspectFit" />
    </view>
    <view class="account-copy">
      <text class="account-name">{{loggedInUser || '欢迎使用忆声智护'}}</text>
      <text class="account-detail">
        {{loggedInUser ? '已登录 · 个人观察档案' : '登录后查看您的观察记录'}}
      </text>
    </view>
    <button wx:if="{{!loggedInUser}}" class="account-login" size="mini" bindtap="toggleLogin">
      {{loginExpanded ? '收起' : '登录/注册'}}
    </button>
  </view>
  <view wx:if="{{loginExpanded && !loggedInUser}}" class="login-card glass-surface">
    <view class="auth-segment" aria-role="group" aria-label="账号操作">
      <button
        class="auth-option {{authMode === 'login' ? 'auth-option--selected' : ''}}"
        data-mode="login"
        disabled="{{busy}}"
        aria-pressed="{{authMode === 'login'}}"
        bindtap="onAuthMode"
      >
        账号登录
      </button>
      <button
        class="auth-option {{authMode === 'register' ? 'auth-option--selected' : ''}}"
        data-mode="register"
        disabled="{{busy}}"
        aria-pressed="{{authMode === 'register'}}"
        bindtap="onAuthMode"
      >
        注册账号
      </button>
    </view>
    <text class="secondary login-explanation">
      {{authMode === 'register' ? '创建账号后，可保存和查看您的观察记录。' :
      '使用已有项目账号与密码。'}}
    </text>
    <view wx:if="{{savedMode !== 'live'}}" class="auth-environment">
      <text class="secondary">登录和注册需要连接真实服务。</text>
      <button class="btn btn-secondary section-gap" bindtap="openConnection">去连接服务</button>
    </view>
    <text class="form-label">账号</text>
    <input
      id="auth-username"
      class="field"
      value="{{username}}"
      disabled="{{busy}}"
      placeholder="请输入账号"
      placeholder-class="input-placeholder"
      bindinput="onUsername"
      maxlength="64"
      aria-label="账号"
    />
    <text class="form-label">密码</text>
    <view class="password-field">
      <input
        id="auth-password"
        class="field"
        value="{{password}}"
        password="{{!passwordVisible}}"
        disabled="{{busy}}"
        placeholder="{{authMode === 'register' ? '设置 8–64 位密码' : '请输入密码'}}"
        placeholder-class="input-placeholder"
        bindinput="onPassword"
        bindconfirm="submitAuth"
        confirm-type="done"
        maxlength="{{authMode === 'register' ? 64 : 140}}"
        aria-label="密码"
      />
      <button
        class="password-toggle"
        size="mini"
        aria-label="{{passwordVisible ? '隐藏密码' : '显示密码'}}"
        bindtap="togglePassword"
      >
        {{passwordVisible ? '隐藏' : '显示'}}
      </button>
    </view>
    <block wx:if="{{authMode === 'register'}}">
      <text class="form-label">确认密码</text>
      <input
        id="auth-confirm"
        class="field"
        value="{{confirmPassword}}"
        password="{{true}}"
        disabled="{{busy}}"
        placeholder="请再次输入密码"
        placeholder-class="input-placeholder"
        bindinput="onConfirmPassword"
        bindconfirm="submitAuth"
        confirm-type="done"
        maxlength="64"
        aria-label="确认密码"
      />
    </block>
    <text
      wx:if="{{status && statusArea === 'auth'}}"
      class="inline-feedback {{statusError ? 'text-error' : ''}}"
      aria-role="status"
    >
      {{status}}
    </text>
    <button
      class="btn btn-primary section-gap"
      loading="{{busy}}"
      disabled="{{busy || savedMode !== 'live'}}"
      bindtap="submitAuth"
    >
      {{authMode === 'register' ? '创建账号' : '登录'}}
    </button>
  </view>
  <view id="connection-settings" class="settings-group glass-surface">
    <setting-row icon="text-size" label="大字模式" detail="放大文字，便于阅读。">
      <switch
        checked="{{largeText}}"
        color="#168773"
        disabled="{{busy}}"
        bindchange="onTextChange"
        aria-label="大字模式"
      />
    </setting-row>
    <view class="setting-divider"></view>
    <setting-row
      icon="server"
      label="服务连接"
      detail="{{connectionSummary}}"
      arrow="{{true}}"
      expanded="{{connectionExpanded}}"
      disabled="{{busy}}"
      bindselect="toggleConnection"
    />
    <view wx:if="{{connectionExpanded}}" class="connection-details motion-enter">
      <text class="form-label">后端服务地址</text>
      <input
        class="field"
        value="{{apiBaseUrl}}"
        disabled="{{busy}}"
        placeholder="https://您的服务地址"
        placeholder-class="input-placeholder"
        bindinput="onBaseUrl"
        adjust-position="{{true}}"
      />
      <text class="secondary service-explanation">
        真实服务支持文字问答与已有记录查询。录音与认知分析尚未开放。
      </text>
      <text class="secondary connection-guidance">{{connectionHint}}</text>
      <button
        wx:if="{{deviceBaseUrl}}"
        class="btn btn-secondary"
        disabled="{{busy}}"
        bindtap="useDeviceAddress"
      >
        连接本机调试服务
      </button>
      <text wx:if="{{deviceBaseUrl}}" class="secondary device-address" selectable="{{true}}">
        手机地址：{{deviceBaseUrl}}
      </text>
      <button class="btn btn-secondary" disabled="{{busy}}" bindtap="saveConfig">保存设置</button>
      <button
        wx:if="{{apiBaseUrl}}"
        class="btn btn-plain section-gap"
        disabled="{{busy}}"
        bindtap="copyHealthUrl"
      >
        复制浏览器检测地址
      </button>
      <text
        wx:if="{{status && statusArea === 'connection'}}"
        class="inline-feedback {{statusError ? 'text-error' : ''}}"
        aria-role="status"
      >
        {{status}}
      </text>
      <text
        wx:if="{{connectionErrorDetail}}"
        class="secondary connection-native-error"
        selectable="{{true}}"
      >
        微信返回：{{connectionErrorDetail}}
      </text>
    </view>
    <view class="setting-divider"></view>
    <setting-row
      icon="layers"
      label="服务模式"
      detail="{{hasChanges ? '有更改待保存' : savedMode === 'demo' ? '当前使用演示服务' : '当前使用真实服务'}}"
    />
    <view class="mode-segment" aria-role="group" aria-label="服务模式">
      <button
        class="segment-option {{mode === 'demo' ? 'segment-option--selected' : ''}}"
        data-mode="demo"
        disabled="{{busy}}"
        aria-pressed="{{mode === 'demo'}}"
        bindtap="onModeSelect"
      >
        演示服务
      </button>
      <button
        class="segment-option {{mode === 'live' ? 'segment-option--selected' : ''}}"
        data-mode="live"
        disabled="{{busy}}"
        aria-pressed="{{mode === 'live'}}"
        bindtap="onModeSelect"
      >
        真实服务
      </button>
    </view>
    <view class="setting-divider"></view>
    <setting-row
      icon="wifi"
      label="连接测试"
      detail="{{connectionTestLabel}}"
      arrow="{{true}}"
      disabled="{{busy}}"
      bindselect="testConnection"
    />
    <view class="setting-divider"></view>
    <setting-row
      icon="info"
      label="关于忆声智护"
      detail="版本 V{{version}}"
      arrow="{{true}}"
      bindselect="showAbout"
    />
  </view>
  <text
    wx:if="{{status && !(loginExpanded && statusArea === 'auth') && !(connectionExpanded && statusArea === 'connection')}}"
    class="profile-feedback glass-surface {{statusError ? 'text-error' : 'text-green'}}"
    aria-role="status"
  >
    {{status}}
  </text>

  <button
    wx:if="{{loggedInUser}}"
    class="logout glass-surface"
    disabled="{{busy}}"
    bindtap="signOut"
    hover-class="pressed"
  >
    <image src="/assets/icons/logout.png" mode="aspectFit" />
    <text>退出登录</text>
  </button>
  <glass-modal
    id="about-sheet"
    visible="{{aboutVisible}}"
    title="关于忆声智护"
    content="忆声智护 V{{version}}
温柔陪伴，记录点滴。

当前支持账号注册、登录、文字问答与已有观察记录查询。数字人为静态形象；语音、实时 3D 和真实录音观察尚未开放。"
    bindclose="closeAbout"
    bindconfirm="closeAbout"
  />
  <glass-modal
    visible="{{logoutVisible}}"
    title="退出当前账号？"
    content="退出后，您可以重新登录查看观察记录。"
    confirm-text="退出登录"
    show-cancel="{{true}}"
    danger="{{true}}"
    bindclose="cancelSignOut"
    bindconfirm="confirmSignOut"
  />
</view>
