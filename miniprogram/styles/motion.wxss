.motion-press {
  transition: transform 210ms cubic-bezier(0.18, 0.9, 0.32, 1.22);
}

.motion-press.pressed {
  transform: scale(0.975);
  transition: transform 90ms ease-out;
}

.motion-enter {
  animation: motion-enter var(--enter-time, 200ms) cubic-bezier(0.18, 0.9, 0.32, 1.12);
}

@keyframes motion-enter {
  from {
    opacity: var(--enter-opacity, 0.78);
    transform: translateY(var(--enter-distance, 8rpx));
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .motion-press,
  .motion-press.pressed {
    transform: none;
    transition: none;
  }
  .motion-enter {
    animation: none;
  }
}
