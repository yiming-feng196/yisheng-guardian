page {
  height: 100%;
  background: #dce6f5;
  color: #142536;
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  font-size: 30rpx;
  line-height: 1.5;
}
view,
scroll-view,
button,
input,
text,
checkbox-group,
label {
  box-sizing: border-box;
}
.page {
  --brand: #168773;
  --text: #142536;
  --text-secondary: #586779;
  --font-title: max(26px, 54rpx);
  --font-name: max(30px, 62rpx);
  --font-greeting: max(23px, 46rpx);
  --font-card: max(19px, 38rpx);
  --font-body: max(16px, 31rpx);
  --font-button: max(17px, 33rpx);
  --font-secondary: max(14px, 27rpx);
  --font-status: max(13px, 25rpx);
  min-height: 100%;
  padding: 28rpx 32rpx calc(var(--nav-space, 100px) + 28rpx);
  position: relative;
  isolation: isolate;
  color: var(--text);
  font-size: var(--font-body);
}
.page.large {
  --font-title: max(33px, 66rpx);
  --font-name: max(38px, 76rpx);
  --font-greeting: max(29px, 58rpx);
  --font-card: max(24px, 47rpx);
  --font-body: max(20px, 39rpx);
  --font-button: max(21px, 41rpx);
  --font-secondary: max(17px, 34rpx);
  --font-status: max(16px, 31rpx);
}
.scene-background {
  position: fixed;
  z-index: -2;
  inset: 0;
  pointer-events: none;
  background: #dce6f5;
}
.scene-background::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(228, 238, 249, 0.06), rgba(248, 247, 244, 0.12));
}
.ginkgo {
  position: absolute;
  z-index: -1;
  pointer-events: none;
  right: 16rpx;
  top: 32rpx;
  width: 200rpx;
  height: 240rpx;
  opacity: 0.65;
}
.glass-surface {
  background: linear-gradient(125deg, rgba(255, 255, 255, 0.57), rgba(255, 255, 255, 0.33));
  border: 1px solid rgba(255, 255, 255, 0.78);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.5),
    0 14rpx 44rpx rgba(74, 93, 137, 0.055);
}
.glass-card {
  border-radius: 48rpx;
  padding: 32rpx;
}
.title {
  font-size: var(--font-card);
  font-weight: 600;
  line-height: 1.4;
  margin: 0;
}
.body-text {
  display: block;
  font-size: var(--font-body);
  line-height: 1.6;
  color: #586779;
  word-break: break-word;
}
.secondary {
  font-size: var(--font-secondary);
  line-height: 1.6;
  color: #586779;
}
.text-error {
  color: #a14141 !important;
}
.text-green {
  color: #146653;
}
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 104rpx;
  height: auto;
  margin: 0;
  padding: 22rpx 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.74);
  border-radius: 999px;
  font-size: var(--font-button);
  font-weight: 600;
  line-height: 1.4;
  box-sizing: border-box;
  word-break: keep-all;
  transition:
    transform 120ms ease,
    filter 120ms ease;
}
button::after {
  border: 0;
}
button {
  font-family: inherit;
}
button[disabled] {
  opacity: 0.48;
}
.btn-primary {
  background: linear-gradient(120deg, #83c5b5 0%, #168773 25%, #146653 75%, #319982 100%);
  color: #fff;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.4),
    0 10rpx 28rpx rgba(22, 135, 115, 0.12);
}
.btn-secondary {
  background: rgba(255, 255, 255, 0.5);
  color: #146653;
}
.btn-plain {
  background: transparent;
  color: #586779;
  border-color: transparent;
}
.btn image {
  width: 36rpx;
  height: 36rpx;
  flex: none;
}
.pressed {
  transform: scale(0.975);
  filter: brightness(0.97);
}
.icon-button {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 44px !important;
  height: 44px !important;
  min-width: 44px;
  min-height: 44px;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}
.icon-button image {
  width: 40rpx;
  height: 40rpx;
}
.field {
  width: 100%;
  height: 104rpx;
  min-height: 48px;
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  padding: 0 26rpx;
  color: #142536;
  background: rgba(255, 255, 255, 0.6);
  font-size: var(--font-body);
}
.input-placeholder {
  color: #69768a;
}
.section-gap {
  margin-top: 28rpx;
}
.page-note {
  display: block;
  text-align: center;
  font-size: var(--font-secondary);
  line-height: 1.6;
  color: #586779;
  margin: 30rpx 8rpx 0;
}
.form-label {
  display: block;
  font-size: var(--font-secondary);
  color: #586779;
  margin: 20rpx 0 10rpx;
}
.inline-feedback {
  display: block;
  font-size: var(--font-secondary);
  line-height: 1.6;
  color: #146653;
  margin-top: 20rpx;
  word-break: break-word;
}
.screen-enter {
  animation: page-enter 220ms ease-out;
}
@keyframes page-enter {
  from {
    opacity: 0.75;
    transform: translateY(6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@media (prefers-reduced-motion: reduce) {
  .screen-enter {
    animation: none;
  }
  .btn {
    transition: none;
  }
}
@supports (backdrop-filter: blur(20px)) {
  .glass-float {
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
  }
}
@media (prefers-reduced-transparency: reduce) {
  .glass-surface {
    background: rgba(241, 246, 252, 0.96);
  }
}

.scene-background-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.page {
  padding-left: max(16px, 32rpx);
  padding-right: max(16px, 32rpx);
}

button.btn {
  width: 100% !important;
  min-width: 0;
}
