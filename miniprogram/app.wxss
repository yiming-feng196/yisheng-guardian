/* Shared iOS-inspired tokens; WeChat owns the navigation and safe-area insets. */
page { height:100%; background:#f2f2f7; color:#1c1c1e; font:34rpx/1.55 -apple-system,BlinkMacSystemFont,"Helvetica Neue","PingFang SC",sans-serif; -webkit-text-size-adjust:100%; }
view,scroll-view,textarea,input,button { box-sizing:border-box; }
button { margin:0; font-size:inherit; line-height:1.45; -webkit-user-select:none; user-select:none; -webkit-tap-highlight-color:transparent; transition:transform 120ms cubic-bezier(.23,1,.32,1),opacity 120ms ease-out; }
button::after { border:0; }
button[disabled] { opacity:.42; }
button:not([disabled]):active,.pressable { transform:scale(.98); opacity:.8; }
.page { min-height:100%; padding:20rpx 40rpx 48rpx; font-size:34rpx; line-height:1.55; }
.page.large { font-size:42rpx; }
.page-header { display:flex; justify-content:space-between; align-items:center; margin:6rpx 0 28rpx; }
.header-copy { min-width:0; flex:1; }
.eyebrow { margin-bottom:6rpx; color:#63636b; font-size:.76em; font-weight:500; }
.page-title { font-size:1.94em; font-weight:700; letter-spacing:-.04em; line-height:1.18; }
.subtitle { margin-top:14rpx; color:#63636b; font-size:.88em; line-height:1.6; }
.header-logo { width:88rpx; height:88rpx; margin-left:20rpx; border-radius:26rpx; background:#fff; }
.section-heading { display:flex; justify-content:space-between; align-items:baseline; margin:32rpx 4rpx 14rpx; }
.section-heading-title { font-size:1.12em; font-weight:650; letter-spacing:-.02em; }
.section-caption { color:#63636b; font-size:.76em; }
.section-title { font-size:1.12em; font-weight:650; line-height:1.4; letter-spacing:-.02em; }
.card { padding:32rpx; margin-bottom:24rpx; border-radius:32rpx; background:#fff; }
.glass { background:rgba(255,255,255,.76); border:1rpx solid rgba(255,255,255,.94); box-shadow:0 12rpx 40rpx rgba(38,62,54,.07),inset 0 1rpx 0 rgba(255,255,255,.8); -webkit-backdrop-filter:blur(24px) saturate(150%); backdrop-filter:blur(24px) saturate(150%); }
.group { overflow:hidden; border-radius:28rpx; background:#fff; }
.group-row { display:flex; align-items:center; min-height:112rpx; padding:24rpx 28rpx; }
.group-row+.group-row { border-top:1rpx solid #e5e5ea; }
.row-copy { min-width:0; flex:1; }
.row-title { font-size:1em; font-weight:500; }
.row-detail { margin-top:6rpx; color:#63636b; font-size:.8em; line-height:1.5; }
.row-icon { display:flex; justify-content:center; align-items:center; flex-shrink:0; width:64rpx; height:64rpx; margin-right:22rpx; border-radius:17rpx; background:#e9f3ee; }
.row-icon image { width:38rpx; height:38rpx; }
.row-icon.blue { background:#ebf2ff; }
.row-icon.orange { background:#fff2e6; }
.row-icon.purple { background:#f2edfc; }
.chevron { flex-shrink:0; width:28rpx; height:28rpx; margin-left:16rpx; }
.primary-button,.secondary-button { display:flex; align-items:center; justify-content:center; padding:24rpx 28rpx; min-height:48px; border-radius:26rpx; font-weight:600; }
.primary-button { color:#fff; background:#176b52; }
.secondary-button { color:#176b52; background:#e9f3ee; }
.small-button { min-height:88rpx; padding:18rpx 24rpx; font-size:.92em; }
.button-icon { width:38rpx; height:38rpx; margin-left:14rpx; flex-shrink:0; }
.button-row { display:flex; align-items:stretch; margin-top:24rpx; }
.button-row>button { flex:1; }
.button-row>button+button { margin-left:16rpx; }
.field-label { display:block; font-size:.86em; font-weight:500; margin:24rpx 0 12rpx; }
.field { width:100%; min-height:100rpx; padding:22rpx 24rpx; border:1rpx solid #e5e5ea; border-radius:22rpx; background:#f7f7fa; color:#1c1c1e; font-size:inherit; }
.placeholder { color:#777780; }
.note { color:#63636b; font-size:.84em; line-height:1.65; }
.group-footer { padding:14rpx 24rpx 0; color:#63636b; font-size:.76em; line-height:1.65; }
.status { margin-top:20rpx; padding:22rpx 24rpx; border-radius:20rpx; background:#e9f3ee; color:#176b52; font-size:.86em; word-break:break-word; }
.error { color:#a33a31; background:#fff0ed; }
.empty { padding:64rpx 32rpx; text-align:center; }
.empty-icon { width:80rpx; height:80rpx; margin-bottom:24rpx; }
.empty-title { font-size:1.12em; font-weight:600; margin-bottom:12rpx; }
.spaced { margin-top:24rpx; }
.badge { display:inline-block; flex-shrink:0; padding:6rpx 16rpx; border-radius:12rpx; color:#176b52; background:#e9f3ee; font-size:.72em; font-weight:500; line-height:1.5; }
.badge.neutral { background:#f2f2f7; color:#63636b; }
.row { display:flex; justify-content:space-between; align-items:center; }
.divider { border-top:1rpx solid #e5e5ea; margin-top:24rpx; padding-top:24rpx; }
.page-end { padding:20rpx 12rpx 0; color:#63636b; text-align:center; font-size:.72em; line-height:1.6; }
@media (prefers-reduced-motion:reduce) { button { transition:none; } button:not([disabled]):active,.pressable { transform:none; } }
@media (prefers-reduced-transparency:reduce) { .glass { background:#fff; -webkit-backdrop-filter:none; backdrop-filter:none; } }
@media (prefers-contrast:more) { .glass { background:#fff; border-color:#8e8e93; } }
