page { height: 100%; background: #f5f8f3; color: #203c30; font-size: 32rpx; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
view, scroll-view, textarea, input, button { box-sizing: border-box; }
button { margin: 0; font-size: inherit; line-height: 1.4; }
button::after { border: 0; }
button[disabled] { opacity: .55; }
.page { padding: 28rpx; font-size: 32rpx; line-height: 1.6; }
.page.large { font-size: 38rpx; }
.page-title { font-size: 1.45em; font-weight: 650; line-height: 1.35; margin: 12rpx 0; }
.section-title { font-size: 1.12em; font-weight: 650; margin-bottom: 16rpx; }
.subtitle { color: #456151; margin-bottom: 24rpx; }
.card { margin-bottom: 24rpx; padding: 28rpx; background: #fff; border: 1rpx solid #dce6dc; border-radius: 28rpx; }
.primary-button, .secondary-button { padding: 24rpx; min-height: 96rpx; border-radius: 22rpx; font-weight: 600; }
.primary-button { color: #fff; background: #125744; }
.secondary-button { color: #125744; background: #eaf3ec; border: 1rpx solid #cedfd1; }
.small-button { min-height: 72rpx; padding: 14rpx 22rpx; font-size: .92em; }
.button-row { display: flex; align-items: center; margin-top: 24rpx; }
.button-row > button { flex: 1; }
.button-row > button + button { margin-left: 16rpx; }
.field-label { display: block; font-weight: 600; margin: 20rpx 0 12rpx; }
.field { width: 100%; min-height: 92rpx; padding: 18rpx; border: 1rpx solid #bacfbe; border-radius: 16rpx; background: #fafcf9; color: #203c30; font-size: inherit; }
.note { color: #456151; font-size: .94em; line-height: 1.65; }
.status { margin-top: 18rpx; padding: 18rpx; border-radius: 16rpx; background: #eaf3ec; word-break: break-all; }
.error { color: #9d342b; background: #fff0ed; }
.empty { padding: 48rpx 20rpx; text-align: center; }
.empty-title { font-weight: 600; margin-bottom: 12rpx; }
.spaced { margin-top: 24rpx; }
.badge { display: inline-block; padding: 4rpx 16rpx; border-radius: 24rpx; background: #eaf3ec; color: #125744; font-size: .86em; }
.row { display: flex; justify-content: space-between; align-items: center; }
.divider { border-top: 1rpx solid #e2eae0; margin-top: 24rpx; padding-top: 24rpx; }
