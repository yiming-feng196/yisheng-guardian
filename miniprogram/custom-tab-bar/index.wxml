<view
  hidden="{{hidden}}"
  class="tab-dock {{largeText ? 'tab-dock--large' : ''}}"
  style="bottom:{{safeBottom + 8}}px"
  aria-role="tablist"
>
  <view class="tab-track">
    <view class="tab-selection" style="transform:translateX({{selected * 100}}%)"></view>
    <button
      wx:for="{{tabs}}"
      wx:key="url"
      class="tab-item motion-press {{selected === index ? 'tab-item--selected' : ''}}"
      hover-class="pressed"
      data-index="{{index}}"
      aria-role="tab"
      aria-selected="{{selected === index}}"
      aria-label="{{item.text}}"
      bindtap="switchTab"
    >
      <image
        src="/assets/icons/{{item.icon}}{{selected === index ? '-active' : ''}}.png"
        mode="aspectFit"
        aria-hidden="true"
      />
      <text>{{item.text}}</text>
    </button>
  </view>
</view>
