<view class="state glass-surface">
  <view class="state-symbol">
    <image class="state-icon" src="/assets/icons/{{icon}}.png" mode="aspectFit" aria-hidden="true" />
  </view>
  <text class="state-title">{{title}}</text>
  <text class="state-message {{error ? 'text-error' : ''}}">{{message}}</text>
  <button wx:if="{{action}}" class="btn btn-primary" bindtap="act">{{action}}</button>
</view>
