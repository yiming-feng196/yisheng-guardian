:host {
  display: block;
  height: 100%;
  min-height: 0;
}
.chat-panel {
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  border-radius: 44rpx;
  padding: 0 var(--space-2) var(--space-2);
  background: linear-gradient(125deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.34));
  box-shadow: var(--surface-shadow);
  overflow: hidden;
}
.chat-panel--expanded {
  background: rgba(243, 247, 254, 0.8);
}
.chat-handle {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  width: 100%;
  min-height: var(--touch-min);
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  color: #586779;
  font-size: var(--font-secondary);
  line-height: 1.4;
}
.handle-mark {
  width: 16rpx;
  height: 16rpx;
  border-left: 5rpx solid #778396;
  border-top: 5rpx solid #778396;
  border-radius: 3rpx;
  transform: translateY(4rpx) rotate(45deg);
  flex: none;
}
.handle-mark--down {
  transform: translateY(-4rpx) rotate(225deg);
}
.chat-history {
  --enter-time: 270ms;
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}
.chat-mode {
  display: block;
  text-align: center;
  color: #805e38;
  font-size: var(--font-status);
  padding: 4rpx 0 20rpx;
}
.chat-message {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  --enter-time: 190ms;
  margin: 0 0 var(--space-2);
}
.chat-message--user {
  align-items: flex-end;
}
.chat-bubble {
  max-width: 91%;
  box-sizing: border-box;
  padding: var(--space-2) var(--space-3);
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-radius: 30rpx 30rpx 30rpx 8rpx;
  font-size: var(--font-body);
  line-height: var(--body-leading);
  text-indent: 0;
  text-align: left;
  white-space: pre-wrap;
  word-break: break-word;
}
.chat-message--user .chat-bubble {
  background: rgba(218, 239, 233, 0.92);
  border-radius: 30rpx 30rpx 8rpx 30rpx;
  color: #145b4e;
}
.chat-bubble--error {
  color: #a14141;
  background: #fceeee;
}
.chat-notice {
  color: #586779;
  font-size: var(--font-secondary);
  line-height: 1.5;
  padding: 12rpx 10rpx;
  max-width: 95%;
}
.chat-thinking {
  font-size: var(--font-secondary);
  color: #146653;
  padding: 0 16rpx 24rpx;
}
.composer {
  flex: none;
  display: flex;
  gap: var(--space-2);
  align-items: center;
  min-height: 96rpx;
  padding: 4rpx 6rpx 4rpx 28rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid rgba(255, 255, 255, 0.75);
  border-radius: 999px;
  box-sizing: border-box;
}
.composer-input {
  flex: 1;
  min-width: 0;
  width: 0;
  height: 48px;
  font-size: var(--font-body);
  color: #142536;
  line-height: 1.5;
}
.send-button {
  position: relative;
  display: flex !important;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 88rpx !important;
  min-width: var(--touch-min);
  height: 88rpx !important;
  min-height: var(--touch-min);
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50%;
  background: linear-gradient(145deg, #83c5b5, #168773) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
  color: #fff;
  line-height: 1;
}
.send-button--loading::before { margin: 0; }
.send-button .send-arrow {
  pointer-events: none;
  position: absolute;
  top: 50%;
  left: 50%;
  display: block;
  width: 42rpx;
  height: 42rpx;
  margin: 0;
  transform: translate(-50%, -50%);
}
.send-button.send-button--disabled {
  background: #83bcb1 !important;
  opacity: 0.65 !important;
}
.composer--voice { padding-left: 6rpx; }
.voice-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: max(var(--touch-min), 88rpx) !important;
  height: max(var(--touch-min), 88rpx) !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50%;
  color: #146653;
  background: rgba(218, 239, 233, 0.8);
  font-size: 14px;
}
.voice-icon {
  width: 24px;
  height: 24px;
}
.voice-button--active {
  background: #168773 !important;
  color: white;
}
.voice-feedback {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: none;
  color: #146653;
  text-align: center;
  padding: 0 0 4rpx;
  font-size: 14px;
}
.voice-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  width: auto;
  min-height: 44px;
  padding: 0 12px;
  margin: 0;
  font-size: 14px;
  color: #146653;
  background: transparent;
}
.read-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 6px;
}
.read-reply {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto !important;
  line-height: 1.3;
  margin: 0 !important;
  min-height: 44px;
  padding: 8px 12px !important;
  border: 0;
  border-radius: 16px;
  font-size: 14px;
  color: #146653;
  background: rgba(218, 239, 233, 0.65);
}
.speech-options {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
  min-height: 44px;
  padding: 0 4px 6px;
  color: #586779;
  font-size: 14px;
}
