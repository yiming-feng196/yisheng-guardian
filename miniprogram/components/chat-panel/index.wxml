<view class="chat-panel glass-surface glass-float {{expanded ? 'chat-panel--expanded' : ''}}">
  <button
    class="chat-handle"
    aria-label="{{expanded ? '收起对话' : '展开对话'}}"
    aria-expanded="{{expanded}}"
    bindtap="toggle"
  >
    <view class="handle-mark {{expanded ? 'handle-mark--down' : ''}}"></view>
    <text wx:if="{{expanded}}">与小忆的对话</text>
  </button>
  <view wx:if="{{expanded && mode === 'live'}}" class="speech-options">
    <text>自动朗读回复</text>
    <switch checked="{{autoRead}}" color="#168773" aria-label="自动朗读回复" bindchange="autoReadChange" />
  </view>
  <scroll-view
    wx:if="{{expanded}}"
    class="chat-history"
    scroll-y="{{true}}"
    scroll-into-view="{{scrollTarget}}"
    scroll-with-animation="{{true}}"
  >
    <text wx:if="{{mode === 'demo'}}" class="chat-mode">演示回复 · 未调用 AI</text>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="{{item.id}}"
      class="chat-message chat-message--{{item.role}}"
    >
      <text class="chat-bubble {{item.error ? 'chat-bubble--error' : ''}}" selectable="{{true}}">
        {{item.content}}
      </text>
      <button wx:if="{{mode === 'live' && item.role === 'assistant' && !item.error && item.id !== 'greeting'}}" class="read-reply" data-id="{{item.id}}" disabled="{{sending || (voiceState !== 'idle' && voiceState !== 'playing' && voiceState !== 'synthesizing')}}" bindtap="speak">{{speakingId === item.id ? (voiceState === 'playing' ? '停止朗读' : '取消朗读') : '朗读回复'}}</button>
      <text wx:if="{{item.notice}}" class="chat-notice">{{item.notice}}</text>
    </view>
    <view wx:if="{{sending}}" id="chat-thinking" class="chat-thinking" aria-role="status">
      小忆正在思考…
    </view>
  </scroll-view>
  <view wx:if="{{voiceState !== 'idle'}}" class="voice-feedback" aria-role="status">{{voiceLabel}} {{voiceState === 'recording' ? voiceSeconds + '秒' : ''}}</view>
  <view class="composer">
    <button class="voice-button {{voiceState === 'recording' ? 'voice-button--active' : ''}}" disabled="{{sending}}" bindtap="voice" aria-label="{{voiceState === 'recording' ? '结束录音并转成文字' : voiceState !== 'idle' ? '取消语音操作' : '开始录音'}}">
      <image wx:if="{{voiceState === 'idle'}}" src="/assets/icons/microphone.png" mode="aspectFit" />
      <text wx:else>{{voiceState === 'recording' ? '结束' : '取消'}}</text>
    </button>
    <input
      class="composer-input"
      value="{{value}}"
      placeholder="和小忆说说话……"
      placeholder-class="input-placeholder"
      maxlength="500"
      confirm-type="send"
      adjust-position="{{false}}"
      cursor-spacing="12"
      bindinput="input"
      bindfocus="focus"
      bindblur="blur"
      bindkeyboardheightchange="keyboard"
      bindconfirm="send"
    />
    <button
      class="send-button"
      disabled="{{sending || !value || (voiceState !== 'idle' && voiceState !== 'playing' && voiceState !== 'synthesizing')}}"
      loading="{{sending}}"
      aria-label="发送消息"
      bindtap="send"
    >
      <image wx:if="{{!sending}}" src="/assets/icons/arrow-up.png" mode="aspectFit" />
    </button>
  </view>
  <text wx:if="{{expanded && voiceState === 'idle'}}" class="voice-help">{{mode === 'live' && autoRead ? '回复会自动朗读，可随时停止。' : ''}}录音确认后才发送。朗读文字会提交至在线语音服务。</text>
</view>
