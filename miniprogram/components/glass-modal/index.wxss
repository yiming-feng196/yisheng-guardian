.modal-layer {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(25, 42, 65, 0.22);
}
.modal-sheet {
  --enter-time: 260ms;
  --enter-distance: 24rpx;
  position: relative;
  width: 100%;
  max-width: 720rpx;
  max-height: 85vh;
  padding: 36rpx;
  border-radius: 52rpx;
  background: rgba(244, 247, 253, 0.94);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.modal-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.modal-title {
  flex: 1;
  font-size: var(--font-card);
  font-weight: 600;
  line-height: 1.4;
}
.close-button {
  flex: none;
  font-size: 42rpx;
  color: #586779;
}
.modal-caption {
  font-size: var(--font-secondary);
  color: #586779;
  margin: 8rpx 0 20rpx;
}
.modal-scroll {
  min-height: 80rpx;
  max-height: 50vh;
  margin: 16rpx 0 24rpx;
  box-sizing: border-box;
}
.modal-content {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.65;
  font-size: var(--font-body);
}
.modal-footnote {
  font-size: var(--font-secondary);
  line-height: 1.5;
  color: #586779;
  margin-bottom: 24rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-actions .btn {
  flex: 1;
}
.btn-danger {
  color: #a14141;
  background: rgba(251, 234, 233, 0.9);
}
