:host {
  display: block;
  height: 100%;
  min-height: 0;
}
.human-space {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.human-halo {
  position: absolute;
  width: 88%;
  padding-top: 88%;
  left: 6%;
  top: 10%;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.55);
  background: linear-gradient(140deg, rgba(255, 255, 255, 0.27), rgba(235, 243, 255, 0.05));
  box-shadow: inset 0 0 50rpx rgba(255, 255, 255, 0.2);
}
.human-portrait {
  position: absolute;
  width: 100%;
  height: 145%;
  left: 0;
  bottom: -38%;
}
.human-space--compact .human-portrait {
  height: 175%;
  bottom: -75%;
}
.human-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2rpx;
  height: 12%;
  background: linear-gradient(transparent, rgba(226, 235, 247, 0.72));
}
.human-hint {
  position: absolute;
  bottom: 18rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 12rpx 20rpx;
  border-radius: 999px;
  background: rgba(248, 247, 244, 0.88);
  color: #146653;
  font-size: var(--font-status);
  white-space: nowrap;
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.thinking-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #168773;
}
.human-fallback {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #586779;
}
.human-fallback-icon {
  width: 100rpx;
  height: 100rpx;
}
