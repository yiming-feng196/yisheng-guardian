<view class="steps glass-surface" aria-label="观察流程，第{{current + 1}}步，共4步">
  <view
    wx:for="{{steps}}"
    wx:key="*this"
    class="step {{index === current ? 'step--current' : ''}} {{index < current ? 'step--done' : ''}}"
  >
    <view wx:if="{{index < steps.length - 1}}" class="step-line"></view>
    <view class="step-node"><text>{{index < current ? '✓' : index + 1}}</text></view>
    <text class="step-label">{{item}}</text>
  </view>
</view>
