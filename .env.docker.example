# Copy this file to .env before running Docker Compose. Never commit .env.
APP_PORT=8080
# Leave empty when Docker Hub is directly reachable. In restricted networks,
# set a trusted registry mirror prefix, including the trailing slash.
DOCKER_REGISTRY_PREFIX=
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Replace every value below with a strong, unique secret.
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# The Compose stack includes transcription, feature and report workers.
SCREENING_ENGINE_FACTORY=
SCREENING_REQUIRE_AI=false
SCREENING_ASYNC_ENABLED=true

# Optional AI screening settings. To enable, set the engine factory to
# app.ad_diagnose_engine:create_engine and provide a valid API key.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SCREENING_MODEL=deepseek-chat
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# Qdrant is available through the optional `rag` Compose profile. An embedding
# endpoint is still required before these switches can be enabled.
RAG_VECTOR_ENABLED=false
RAG_EMBEDDING_ENABLED=false
QDRANT_VERSION=v1.18.2
